<?xml version="1.0" encoding="utf-8"?>
<!-- A checkbox's tick (MaterialCheckBox's buttonIconTint over
     @drawable/checkbox_tick): the accent while ticked, as the box's outline
     is then, nothing otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:color="?attr/ptAccent" />
    <item android:color="@android:color/transparent" />
</selector>
