<?xml version="1.0" encoding="utf-8"?>
<!--
    The API 29-30 half of the backup policy (android:fullBackupContent). Its Android 12+
    counterpart, which additionally covers device-to-device transfer, is
    res/xml/data_extraction_rules.xml — read that one first; it carries the reasoning.

    The same single include (files/vocab/, the hidden-words store's directory, so its
    rollback journal rides along after a crash mid-write) and the same belt-and-braces
    excludes as the 12+ file, so the policy is identical on every API level we ship. With android:allowBackup="true" this file is live on 29-30, not a
    formality: it is what keeps the user's API keys and translation history out of the
    backup there. BackupRulesTest pins its shape alongside the 12+ file's.

    Same syntax trap as the 12+ file: `path` is required, and `path="."` means the
    domain root and everything under it. And the same rule: never exclude the root
    domain; on restore that is matched by prefix and rejects every file (see the 12+ file).
-->
<full-backup-content>
    <include domain="file" path="vocab" />
    <exclude domain="file" path="vad" />
    <exclude domain="file" path="crashes" />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
</full-backup-content>
