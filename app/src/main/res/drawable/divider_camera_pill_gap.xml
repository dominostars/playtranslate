<?xml version="1.0" encoding="utf-8"?>
<!-- Invisible spacer between the camera control pill's buttons. A LinearLayout
     divider (showDividers="middle") rather than child margins: dividers only
     render between VISIBLE children, so the gap stays symmetric across every
     flavor/play-pause/crop visibility permutation. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <size android:width="6dp" />
    <solid android:color="@android:color/transparent" />
</shape>
