<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="960"
    android:viewportHeight="960">
    <!-- "Add to Anki" variant of ic_card_stack: the cards_stack glyph at its
         original size with a "+" badge overlaid in the bottom-right corner
         (see ic_card_stack for the base path).

         The glyph is clipped to the canvas minus a 410x355 notch in the
         bottom-right corner. The "+" sits inside that notch, so the transparent
         notch is the blank moat that keeps the two marks readable (the same idea
         as the reference cut-corner icon). Single fillColor so the runtime tint
         covers both. The base path keeps its own translateY=+960 (the source SVG
         uses a negative-Y viewport). -->
    <group>
        <clip-path android:pathData="M0,0 H960 V605 H550 V960 H0 Z" />
        <group android:translateY="960">
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M130,-189 81,-546q-5,-32 15.5,-58t52.5,-31l61,435 283,-40h267q-8,21 -24.5,35.5T695,-187l-477,66q-33,5 -58,-15t-30,-53Zm190,-127q-33,0 -56.5,-23.5T240,-396v-364q0,-33 23.5,-56.5T320,-840h480q33,0 56.5,23.5T880,-760v364q0,33 -23.5,56.5T800,-316H320Zm0,-80h480v-364H320v364Zm0,0v-364 364ZM210,-200Zm190,-400h320v-80H400v80Zm0,120h200v-80H400v80Z" />
        </group>
    </group>
    <!-- "+" badge: cross centred at (755,810), x-tips 605/905, y-tips 660/960,
         half-thickness 45. Dropped flush into the corner (bottom tip at the 960
         edge); a ~55px transparent moat separates it from the notched glyph on the
         top and left, the two sides that face the icon. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M710,660 H800 V765 H905 V855 H800 V960 H710 V855 H605 V765 H710 Z" />
</vector>
