<?xml version="1.0" encoding="utf-8"?>
<!-- Muted variant of bg_feature_chip for "what this WON'T do" rows:
     ptCard fill (the same neutral fill as the floating-menu Turn Off
     button), 10dp radius, no stroke. The glyph inside is tinted
     ptTextMuted. -->
