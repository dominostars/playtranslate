<?xml version="1.0" encoding="utf-8"?>
<!-- The app's neutral metadata chip: a lightly rounded ptSurface fill that
     sits one step off the ptCard surface its host is drawn on. Worn by the
     words-list meta row (Common / "in Anki" / frequency badges, matching the
     magnifying-lens meta-row badges) and by the "LLM" provider label on the
     Translation services rows (@style/Text.PT.MetaLabel).

     The lens uses ptCard-on-ptSurface; the list and settings-row surfaces are
     ptCard, so the equivalent step there is ptSurface (and ptSurface stays
     visible on the white ptCard in light theme, where ptCard == ptElevated). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/ptSurface" />
    <corners android:radius="4dp" />
</shape>
