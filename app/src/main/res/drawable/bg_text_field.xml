<?xml version="1.0" encoding="utf-8"?>
<!-- A text field's background (Widget.PlayTranslate.TextField): the
     ptSurface well with 12dp corners (the page's buttons') and a 1dp
     outline, ptOutline at rest and the accent while the field has focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/ptSurface" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="?attr/ptAccent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/ptSurface" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="?attr/ptOutline" />
        </shape>
    </item>
</selector>
