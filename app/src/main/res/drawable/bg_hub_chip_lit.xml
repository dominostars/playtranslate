<?xml version="1.0" encoding="utf-8"?>
<!-- bg_hub_chip with its 1dp stroke in ptAccent instead of ptOutline: the
     lit hub chip (SettingsRenderer.HubCell.lit), whose glyph also breathes
     a glow (GlowImageView). Same fill, radius and stroke width, so lighting
     a cell changes only the rim's colour. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/ptElevated" />
    <corners android:radius="10dp" />
    <stroke
        android:width="1dp"
        android:color="?attr/ptAccent" />
</shape>
