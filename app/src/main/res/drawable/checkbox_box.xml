<?xml version="1.0" encoding="utf-8"?>
<!-- A checkbox's box (MaterialCheckBox's buttonCompat): a 20dp square with
     4dp corners and a 2dp outline in every state, drawn white for
     buttonTint (@color/checkbox_button) to colour, so the error, ticked and
     resting colours live in one list. The transparent fill is load-bearing:
     a GradientDrawable with no fill colour of its own fills its whole shape
     whenever it is tinted (its draw sets the fill paint to opaque black for
     the tint's colour filter), so without it the box draws as a filled
     square. The tick inside is the box's buttonIcon, @drawable/checkbox_tick,
     coloured by @color/checkbox_icon. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <size android:width="20dp" android:height="20dp" />
    <corners android:radius="4dp" />
    <solid android:color="@android:color/transparent" />
    <stroke android:width="2dp" android:color="@android:color/white" />
</shape>
