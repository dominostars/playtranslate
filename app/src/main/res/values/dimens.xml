<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Design-system spacing tokens -->
    <dimen name="pt_radius">14dp</dimen>
    <dimen name="pt_row_min_height">56dp</dimen>
    <dimen name="pt_row_h_padding">16dp</dimen>
    <dimen name="pt_row_v_padding">14dp</dimen>
    <dimen name="pt_group_gap">20dp</dimen>
    <dimen name="pt_section_h_padding">14dp</dimen>

    <!-- Screen-edge inset of the floating workspace card (OverlayWorkspace):
         the game stays visible on all four sides, and the inset is what gives
         the card's elevation shadow room to render. -->
    <dimen name="pt_workspace_inset">32dp</dimen>

    <!-- Offline backend row header touch-target floor (= MaterialSwitch's 48dp
         height) so every enabled row is the same height. Collapsed to 0 by
         SettingsRenderer when the row is in its inert "disabled" state, which
         tightens the title→reason-line spacing. -->
    <dimen name="offline_row_header_min_height">48dp</dimen>

    <!-- Material's minTouchTargetSize, which MaterialSwitch enforces as its own
         android:minHeight. A row whose trailing control is a switch is therefore
         at least this tall before padding; a row that trails something smaller
         (the Add row's "+") has to claim the same floor explicitly, or it sits
         short of the switch rows it shares a card with. -->
    <dimen name="pt_touch_target">48dp</dimen>
</resources>
