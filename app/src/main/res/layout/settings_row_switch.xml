<?xml version="1.0" encoding="utf-8"?>
<!-- Reusable switch row: title + optional subtitle on left, MaterialSwitch
     on right. Whole row is the tap target; switch is non-clickable by
     itself. android:background is the ripple state-list, not a static
     fill — see settings_row_hotkey for the full Overdraw note. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/pt_row_min_height"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="@dimen/pt_row_h_padding"
    android:paddingVertical="9dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    tools:ignore="Overdraw">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginEnd="16dp">

        <TextView
            android:id="@+id/tvRowTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Text.PT.RowTitle" />

        <TextView
            android:id="@+id/tvRowSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:visibility="gone"
            style="@style/Text.PT.RowSubtitle" />
    </LinearLayout>

    <!-- saveEnabled="false": every copy of this row, and of the other switch
         rows, uses the id switchRowToggle, and view state is saved by id. On
         a recreate each switch would take the state of whichever copy saved
         last, and its listener would write that into the host's setting.
         Hosts set the switch from their own state whenever they build it. -->
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switchRowToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:saveEnabled="false"
        app:materialThemeOverlay="@style/Widget.PlayTranslate.MaterialSwitch" />

</LinearLayout>
