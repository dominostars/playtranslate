<?xml version="1.0" encoding="utf-8"?>
<!-- One History date-section's card: rows are added programmatically to
     sectionRows. Sits under a settings_group_header include, matching the
     settings page's header-outside-card rhythm. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="?attr/ptCard"
    app:cardCornerRadius="@dimen/pt_radius"
    app:cardElevation="0dp"
    app:strokeColor="?attr/ptDivider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:id="@+id/sectionRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</com.google.android.material.card.MaterialCardView>
