<?xml version="1.0" encoding="utf-8"?>
<!-- Source (original) section: header + card. Shared by the in-app results page
     (fragment_translation_result.xml) and the over-game capture panel
     (CaptureResultOverlay). merge-rooted so it inlines into a vertical
     LinearLayout parent without adding a wrapper; every id is preserved so the
     fragment's findViewById keeps working unchanged. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="@dimen/pt_group_gap"
        android:paddingBottom="8dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <!-- Tappable area hugs the label text (wrap_content) but fills the row's full
             height (match_parent) so it matches the inline action buttons; the Space
             below keeps those buttons right-aligned where the weighted label used to. -->
        <TextView
            android:id="@+id/labelOriginal"
            style="@style/Text.PT.GroupHeader"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/cd_change_source_language"
            android:text="@string/section_original" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnToggleFurigana"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_toggle_inline_furigana"
            android:src="@drawable/ic_furigana"
            app:tint="?attr/ptTextMuted" />

        <ImageButton
            android:id="@+id/btnSpeakOriginal"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_read_original_aloud"
            android:src="@drawable/ic_lens_speak"
            app:tint="?attr/ptTextMuted" />

        <ImageButton
            android:id="@+id/btnEditOriginal"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_edit_original"
            android:src="@drawable/ic_edit"
            app:tint="?attr/ptTextMuted" />

        <ImageButton
            android:id="@+id/btnCopyOriginal"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_copy_original"
            android:src="@drawable/ic_copy"
            app:tint="?attr/ptTextMuted" />

        <ImageButton
            android:id="@+id/btnToggleOriginal"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_toggle_original_visibility"
            android:src="@drawable/ic_visibility"
            app:tint="?attr/ptTextMuted" />

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardOriginal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/ptCard"
        app:cardCornerRadius="@dimen/pt_radius"
        app:cardElevation="0dp"
        app:strokeColor="?attr/ptDivider"
        app:strokeWidth="1dp">

        <LinearLayout
            android:id="@+id/originalContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/pt_row_h_padding"
            android:paddingVertical="@dimen/pt_row_v_padding">

            <com.playtranslate.ui.ClickableTextView
                android:id="@+id/tvOriginal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textColor="?attr/ptText"
                android:lineSpacingMultiplier="1" />

            <!-- "Scanned by <engine>" + gear. Tapping the row opens the OCR picker.
                 Mirror of the target's "Translated by" note (tvTranslationNote);
                 wrap_content so only the label+gear is the tap target. Shown only
                 for OCR-derived results with >1 available engine (binder).
                 Vertical padding + an equal NEGATIVE bottom margin enlarge the tap
                 target to the card's full content-box height (~36dp) without moving
                 the text or growing the card: paddingTop replaces the old 6dp
                 marginTop (text stays put), and paddingBottom (= the card's bottom
                 inset, pt_row_v_padding) is cancelled by marginBottom=-14dp so the
                 layout footprint is unchanged — the extra height is purely tappable.
                 Biased downward (no top margin) so it never overlaps tvOriginal and
                 steals its word-tap touches. -->
            <LinearLayout
                android:id="@+id/sourceNoteRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="-14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="6dp"
                android:paddingBottom="14dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:contentDescription="@string/cd_choose_ocr"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvSourceNote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/ptTextHint"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/btnSourceOcr"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_settings"
                    app:tint="?attr/ptTextHint" />

            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</merge>
