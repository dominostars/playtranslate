<?xml version="1.0" encoding="utf-8"?>
<!-- Manual trim editor for recorded game audio (Anki sentence cards).
     Skeleton mirrors activity_audio_source_picker.xml: toolbar + body +
     bottom action bar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/ptSurface"
        app:navigationIcon="@drawable/ic_close"
        app:navigationIconTint="?attr/ptText"
        app:title="@string/game_audio_trim_title"
        app:titleTextColor="?attr/ptText" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/ptDivider" />

    <!-- 48dp horizontal inset: a trim handle dragged to the view's edge must
         still sit clear of the system back-gesture zones, or grabbing it
         triggers navigation instead of a drag. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="48dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvTrimDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Text.PT.RowTitle" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp">

            <com.playtranslate.ui.WaveformTrimView
                android:id="@+id/waveformTrim"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ProgressBar
                android:id="@+id/trimLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />

        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTrimPlay"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:text="@string/game_audio_trim_play"
            android:textAllCaps="false" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/ptDivider" />

    <!-- Vertical bar, one action per row. A horizontal row hands every child a
         width budget the longest locale busts: "Use TTS instead" + "No audio" +
         "Use selection" measure ~378dp at 360dp/fontScale 1.0 (~571dp in de,
         ~565dp in tr), and LinearLayout overflows its LAST child — btnTrimSave,
         the confirm — off the right edge, so the trim could not be committed at
         all. Stacked, each child is measured against the bar's content width
         (336dp at 360dp), so horizontal overflow is impossible in any locale at
         any font scale; a label too long for one line wraps instead of clipping
         (no M3 button style sets singleLine/ellipsize — only the .Dialog ones).
         Order matches the old row, so TalkBack traversal is unchanged. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTrimUseTts"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:text="@string/game_audio_trim_use_tts"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTrimNoAudio"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:text="@string/game_audio_trim_no_audio"
            android:textAllCaps="false" />

        <!-- Primary confirm: full-width on its own row, below the secondaries it
             concludes. 8dp clears the group (buttons carry 4dp insets, so the
             gap reads as 16dp). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTrimSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/game_audio_trim_save"
            android:textAllCaps="false" />

    </LinearLayout>

</LinearLayout>
