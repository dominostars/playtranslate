<?xml version="1.0" encoding="utf-8"?>
<!-- One capture session's card (camera or screen capture): origin badge +
     time in the header, an optional tappable thumbnail when the session
     saved an image (opens the import review on it), rows added
     programmatically to sectionRows. Sits inside a day section under its
     settings_group_header, same rhythm as history_section_card. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="?attr/ptCard"
    app:cardCornerRadius="@dimen/pt_radius"
    app:cardElevation="0dp"
    app:strokeColor="?attr/ptDivider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/captureHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:paddingHorizontal="@dimen/pt_row_h_padding"
            android:paddingVertical="8dp">

            <ImageView
                android:id="@+id/captureBadge"
                android:layout_width="18dp"
                android:layout_height="18dp"
                app:tint="?attr/ptTextMuted"
                android:src="@drawable/ic_capture" />

            <TextView
                android:id="@+id/captureMeta"
                style="@style/Text.PT.RowSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp" />

            <!-- Rounded thumbnail via a nested card; GONE unless the
                 session's image exists on disk. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/captureThumbCard"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:visibility="gone"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/ptDivider"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/captureThumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/history_reopen_cd" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="@dimen/pt_row_h_padding"
            android:background="?attr/ptDivider" />

        <LinearLayout
            android:id="@+id/sectionRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
