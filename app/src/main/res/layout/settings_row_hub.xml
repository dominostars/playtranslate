<?xml version="1.0" encoding="utf-8"?>
<!-- Settings "hub cell": icon chip · title + status summary (flex) · trailing
     affordance. No background/corners of its own — those belong to the hosting
     MaterialCardView. Paints only its ripple + an optional in-cell divider
     (GONE on the last cell in a card). Bound by SettingsRenderer.bindHubCell.
     See design_handoff_settings_cell/README.md. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hubRowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- Clipping off so a lit chip's glow (GlowImageView) can overhang the
         chip and spread into this row's padding, as the design's does; it
         stays inside the row, whose root clips. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Slot 1: icon chip (bg_hub_chip, or bg_hub_chip_lit for a lit cell) -->
        <FrameLayout
            android:id="@+id/hubRowChip"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_hub_chip">

            <!-- The 22dp glyph inside 17dp of padding: the view is the size
                 of a lit glyph's glow (it reaches ~25dp from the centre at
                 its peak), centred on the chip and overhanging it. -->
            <com.playtranslate.ui.GlowImageView
                android:id="@+id/hubRowIcon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:padding="17dp"
                android:importantForAccessibility="no"
                app:tint="?attr/ptAccent" />
        </FrameLayout>

        <!-- Slot 2: text block (title + single-line summary) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hubRowTitle"
                style="@style/Text.PT.RowTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/hubRowSummary"
                style="@style/Text.PT.RowSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Slot 3: trailing affordance (chevron / external / lock / none) -->
        <ImageView
            android:id="@+id/hubRowTrailing"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right"
            app:tint="?attr/ptTextMuted" />

        <!-- Trailing spinner — takes the affordance's slot while a cell whose
             tap starts in-cell async work is busy (Trailing.PROGRESS). Sized to
             match the affordance so the row width doesn't shift on the swap;
             exactly one of the two is ever visible. -->
        <ProgressBar
            android:id="@+id/hubRowProgress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:visibility="gone"
            android:indeterminate="true"
            android:indeterminateTint="?attr/ptTextMuted" />
    </LinearLayout>

    <!-- In-cell divider, inset flush with the text block. GONE on the last
         cell in a card (set via bindHubCell's isLast flag). -->
    <View
        android:id="@+id/hubRowDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="66dp"
        android:background="?attr/ptDivider" />
</LinearLayout>
