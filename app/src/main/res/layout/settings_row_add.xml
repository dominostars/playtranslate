<?xml version="1.0" encoding="utf-8"?>
<!-- "Add Online Translation Service" action row: title + subtitle naming
     the services on offer + right-aligned "+" icon. Sits above the
     reorderable instance list, outside the RecyclerView, so it can't be
     dragged; hidden in edit mode. Padding, text stack and the 48dp
     trailing floor mirror item_online_service's rowMain (whose height its
     MaterialSwitch sets, not its text), so the two rows measure alike —
     until the subtitle's service list is too long for the screen and
     wraps, which is the accepted trade. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/pt_row_min_height"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="@dimen/pt_row_h_padding"
    android:paddingVertical="9dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    tools:ignore="Overdraw">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginEnd="16dp">

        <TextView
            android:id="@+id/tvRowTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tr_service_add_online"
            style="@style/Text.PT.RowTitle" />

        <!-- Filled by OnlineServicesController from the add-picker's
             catalog, so a new service shows up here for free. Allowed to
             wrap: naming every service beats standing level with the rows
             below, so on a screen too narrow for the whole list this row
             grows a line rather than ellipsizing the tail away. Where the
             list does fit on one line, the heights still match. -->
        <TextView
            android:id="@+id/tvRowSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            style="@style/Text.PT.RowSubtitle"
            tools:text="OpenAI (DeepSeek, Mistral, Custom), Gemini, DeepL, Lingva" />
    </LinearLayout>

    <!-- 48dp tall, not 24: the instance rows below trail a MaterialSwitch,
         whose 48dp min-touch-target is what sets their height (their text
         stack is shorter than that). The glyph still draws at its natural
         24dp — scaleType only centers it in the taller slot. -->
    <ImageView
        android:id="@+id/ivRowIcon"
        android:layout_width="24dp"
        android:layout_height="@dimen/pt_touch_target"
        android:scaleType="center"
        android:src="@drawable/ic_add"
        app:tint="?attr/ptAccent"
        android:importantForAccessibility="no" />

</LinearLayout>
