<?xml version="1.0" encoding="utf-8"?>
<!-- Static benefit row for onboarding (pageA11y): accent-tint icon chip +
     title/subtitle, chip centered vertically against the text block.
     Non-interactive — no ripple, no chevron, no divider. Icon and texts
     are bound in MainActivity.setupOnboarding(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <FrameLayout
        android:id="@+id/featureChip"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_feature_chip">

        <ImageView
            android:id="@+id/featureIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="?attr/ptAccent" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/featureTitle"
            style="@style/Text.PT.FeatureTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/featureSubtitle"
            style="@style/Text.PT.FeatureSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />

    </LinearLayout>

</LinearLayout>
