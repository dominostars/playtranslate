<?xml version="1.0" encoding="utf-8"?>
<!-- One live-mode session's transcript card: title + start-time/line-count
     meta in a tappable header (chevron mirrors the expand state), rows
     added programmatically to sectionRows. Collapse is binary — a
     collapsed card is JUST the header row (rows + divider gone), and the
     state persists per session in the history DB. Sits inside a day
     section like the other history cards. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="?attr/ptCard"
    app:cardCornerRadius="@dimen/pt_radius"
    app:cardElevation="0dp"
    app:strokeColor="?attr/ptDivider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/liveHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:paddingHorizontal="@dimen/pt_row_h_padding"
            android:paddingVertical="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/liveTitle"
                    style="@style/Text.PT.RowTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/history_live_session_title" />

                <TextView
                    android:id="@+id/liveMeta"
                    style="@style/Text.PT.RowSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <ImageView
                android:id="@+id/liveChevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                app:tint="?attr/ptTextMuted"
                android:src="@drawable/ic_arrow_drop_up" />
        </LinearLayout>

        <View
            android:id="@+id/liveHeaderDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="@dimen/pt_row_h_padding"
            android:background="?attr/ptDivider" />

        <LinearLayout
            android:id="@+id/sectionRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
