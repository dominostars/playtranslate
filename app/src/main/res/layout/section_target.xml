<?xml version="1.0" encoding="utf-8"?>
<!-- Target (translation) section: header + card. Shared by the in-app results
     page (fragment_translation_result.xml) and the over-game capture panel
     (CaptureResultOverlay). merge-rooted so it inlines into a vertical
     LinearLayout parent without adding a wrapper; every id is preserved so the
     fragment's findViewById keeps working unchanged. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <!-- The header: the language name, then the section's actions (the
         "Show on screen" pill, Text size, and the pinned eye),
         which SectionHeaderRow builds from TranslationSectionBinder's
         HeaderActions and folds behind a ⋯ menu when they don't fit. Text
         size lives in THIS header, not the source's, because this row is the
         topmost one in both stacked layouts: re-fitting the text never moves
         it, so the size popover stays glued to its anchor (the button, or ⋯)
         while the user drags. It must stay this merge's FIRST child: the
         capture panel re-pads it through getChildAt(0). -->
    <com.playtranslate.ui.SectionHeaderRow
        android:id="@+id/targetHeaderRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="@dimen/pt_group_gap"
        android:paddingBottom="8dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <!-- Tappable area hugs the label text (wrap_content) but fills the row's full
             height (match_parent) so it matches the inline action buttons. One line:
             the row cuts it with an ellipsis only when the name alone leaves no room
             for ⋯ and the eye, so the header's height never changes. -->
        <TextView
            android:id="@+id/labelTranslation"
            style="@style/Text.PT.GroupHeader"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:ellipsize="end"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/cd_change_target_language"
            android:text="@string/section_translation" />

    </com.playtranslate.ui.SectionHeaderRow>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTranslation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/ptCard"
        app:cardCornerRadius="@dimen/pt_radius"
        app:cardElevation="0dp"
        app:strokeColor="?attr/ptDivider"
        app:strokeWidth="1dp">

        <LinearLayout
            android:id="@+id/translationContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/pt_row_h_padding"
            android:paddingVertical="@dimen/pt_row_v_padding">

            <TextView
                android:id="@+id/tvTranslation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:textColor="?attr/ptText"
                android:lineSpacingMultiplier="1" />

            <!-- "Translated by <service>" (or the warning that stands in its
                 place) + gear. Tapping the row opens the translation service
                 picker, which runs this result through the service picked.
                 Built as the source's "Scanned by" row (sourceNoteRow) is:
                 wrap_content so only the label and gear are the tap target,
                 paddingTop in place of a top margin and a paddingBottom the
                 negative bottom margin cancels, so the tap area reaches the
                 card's bottom inset without the card growing. No
                 contentDescription on the row: it is read as its label, then
                 the gear's description. A warning can run to several lines,
                 so the label has the weight: it gives way and wraps while the
                 gear keeps its size. -->
            <LinearLayout
                android:id="@+id/translationNoteRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="-14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="6dp"
                android:paddingBottom="14dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvTranslationNote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="?attr/ptTextHint"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/btnTranslationService"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@string/cd_choose_translation_service"
                    android:src="@drawable/ic_settings"
                    app:tint="?attr/ptTextHint" />

            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</merge>
