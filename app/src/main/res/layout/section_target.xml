<?xml version="1.0" encoding="utf-8"?>
<!-- Target (translation) section: header + card. Shared by the in-app results
     page (fragment_translation_result.xml) and the over-game capture panel
     (CaptureResultOverlay). merge-rooted so it inlines into a vertical
     LinearLayout parent without adding a wrapper; every id is preserved so the
     fragment's findViewById keeps working unchanged. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="@dimen/pt_group_gap"
        android:paddingBottom="8dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <!-- Tappable area hugs the label text (wrap_content) but fills the row's full
             height (match_parent) so it matches the inline action buttons; the Space
             below keeps those buttons right-aligned where the weighted label used to. -->
        <TextView
            android:id="@+id/labelTranslation"
            style="@style/Text.PT.GroupHeader"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/cd_change_target_language"
            android:text="@string/section_translation" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <!-- "Show on screen" toggle. Over-game capture panel: collapses the
             panel to its sliver and paints the translations over the game.
             In-app results page (dual-screen): paints the one-shot boxes over
             the game display, or — in live mode — flips the hide-overlays-
             during-auto setting. GONE by default; each host decides
             availability (TranslationSectionBinder.setShowOnScreenAvailable).
             A worded button, not an icon: no common glyph reads as "move
             these onto the screen". -->
        <TextView
            android:id="@+id/btnShowOnScreen"
            style="@style/Text.PT.GroupHeader"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="16dp"
            android:paddingHorizontal="12dp"
            android:gravity="center"
            android:background="@drawable/bg_toggle_text_button"
            android:clickable="true"
            android:focusable="true"
            android:textSize="9sp"
            android:text="@string/capture_show_on_screen"
            android:visibility="gone" />

        <!-- Opens the text-size range popover. Lives in the TARGET header (not
             the source) because this row is the topmost one in both stacked
             layouts: re-fitting the text never moves it, so the popover stays
             glued to its anchor while the user drags. GONE until a surface sets
             TranslationSectionBinder.onChooseFontSize. -->
        <ImageButton
            android:id="@+id/btnFontSize"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_text_size"
            android:src="@drawable/ic_format_size"
            android:visibility="gone"
            app:tint="?attr/ptTextMuted" />

        <ImageButton
            android:id="@+id/btnCopyTranslation"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_copy_translation"
            android:src="@drawable/ic_copy"
            app:tint="?attr/ptTextMuted" />

        <ImageButton
            android:id="@+id/btnToggleTranslation"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_toggle_translation_visibility"
            android:src="@drawable/ic_visibility"
            app:tint="?attr/ptTextMuted" />

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTranslation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/ptCard"
        app:cardCornerRadius="@dimen/pt_radius"
        app:cardElevation="0dp"
        app:strokeColor="?attr/ptDivider"
        app:strokeWidth="1dp">

        <LinearLayout
            android:id="@+id/translationContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/pt_row_h_padding"
            android:paddingVertical="@dimen/pt_row_v_padding">

            <TextView
                android:id="@+id/tvTranslation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:textColor="?attr/ptText"
                android:lineSpacingMultiplier="1" />

            <TextView
                android:id="@+id/tvTranslationNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="?attr/ptTextHint"
                android:textSize="11sp"
                android:visibility="gone" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</merge>
