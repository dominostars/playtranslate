<?xml version="1.0" encoding="utf-8"?>
<!-- Target (translation) section: header + card. Shared by the in-app results
     page (fragment_translation_result.xml) and the over-game capture panel
     (CaptureResultOverlay). merge-rooted so it inlines into a vertical
     LinearLayout parent without adding a wrapper; every id is preserved so the
     fragment's findViewById keeps working unchanged. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="@dimen/pt_group_gap"
        android:paddingBottom="8dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/labelTranslation"
            style="@style/Text.PT.GroupHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/section_translation" />

        <ImageButton
            android:id="@+id/btnCopyTranslation"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_copy_translation"
            android:src="@drawable/ic_copy"
            app:tint="?attr/ptTextMuted" />

        <ImageButton
            android:id="@+id/btnToggleTranslation"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_toggle_translation_visibility"
            android:src="@drawable/ic_visibility"
            app:tint="?attr/ptTextMuted" />

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTranslation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/ptCard"
        app:cardCornerRadius="@dimen/pt_radius"
        app:cardElevation="0dp"
        app:strokeColor="?attr/ptDivider"
        app:strokeWidth="1dp">

        <LinearLayout
            android:id="@+id/translationContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/pt_row_h_padding"
            android:paddingVertical="@dimen/pt_row_v_padding">

            <TextView
                android:id="@+id/tvTranslation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:textColor="?attr/ptText"
                android:lineSpacingMultiplier="1" />

            <TextView
                android:id="@+id/tvTranslationNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="?attr/ptTextHint"
                android:textSize="11sp"
                android:visibility="gone" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</merge>
