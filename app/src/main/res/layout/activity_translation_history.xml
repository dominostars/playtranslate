<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/ptSurface"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="?attr/ptText"
        app:title="@string/history_screen_title"
        app:titleTextColor="?attr/ptText" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/ptDivider" />

    <!-- Master switch: the feature's enable lives ON this screen (the
         empty state below doubles as onboarding when it's off). -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="?attr/ptCard"
        app:cardCornerRadius="@dimen/pt_radius"
        app:cardElevation="0dp"
        app:strokeColor="?attr/ptDivider"
        app:strokeWidth="1dp">

        <include layout="@layout/settings_row_switch"
            android:id="@+id/rowHistoryToggle" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvHistoryEmpty"
        style="@style/Text.PT.RowSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="28dp"
        android:paddingVertical="24dp"
        android:gravity="center"
        android:visibility="gone" />

    <!-- wrap_content + the parent's AT_MOST constraint: the card hugs a
         short list and caps at the remaining screen height for a long one
         (the RecyclerView then scrolls internally). GONE while empty — no
         floating empty card. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginVertical="10dp"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/ptCard"
        app:cardCornerRadius="@dimen/pt_radius"
        app:cardElevation="0dp"
        app:strokeColor="?attr/ptDivider"
        app:strokeWidth="1dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
