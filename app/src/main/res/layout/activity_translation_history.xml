<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/ptSurface"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="?attr/ptText"
        app:title="@string/history_screen_title"
        app:titleTextColor="?attr/ptText" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/ptDivider" />

    <!-- One scroll surface for the whole page: toggle, clear, and the list
         move together. The RecyclerView has nested scrolling off, so it
         measures fully and the outer scroll view owns all scrolling;
         reloadNow() compensates the scroll offset on top-inserts to keep
         the reading position anchored. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/historyScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingHorizontal="14dp"
        android:paddingBottom="20dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Master switch: the feature's enable lives ON this screen (the
                 empty state below doubles as onboarding when it's off). -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="?attr/ptCard"
                app:cardCornerRadius="@dimen/pt_radius"
                app:cardElevation="0dp"
                app:strokeColor="?attr/ptDivider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include layout="@layout/settings_row_switch"
                        android:id="@+id/rowHistoryToggle" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="@dimen/pt_row_h_padding"
                        android:background="?attr/ptDivider" />

                    <!-- Save-capture-images sub-toggle: dimmed/disabled while
                         the master switch above is off. -->
                    <include layout="@layout/settings_row_switch"
                        android:id="@+id/rowCaptureImageToggle" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="@dimen/pt_row_h_padding"
                        android:background="?attr/ptDivider" />

                    <!-- Destructive clear-all, confirmed via OverlayAlert. -->
                    <TextView
                        android:id="@+id/rowClearHistory"
                        style="@style/Text.PT.RowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/pt_row_min_height"
                        android:gravity="center"
                        android:textColor="?attr/ptDanger"
                        android:background="?attr/selectableItemBackground"
                        android:text="@string/history_clear_menu" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvHistoryEmpty"
                style="@style/Text.PT.RowSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="14dp"
                android:paddingVertical="24dp"
                android:gravity="center"
                android:visibility="gone" />

            <!-- Date sections (settings_group_header + history_section_card
                 per day), built programmatically with per-entry view reuse.
                 GONE while empty — no floating empty chrome. -->
            <LinearLayout
                android:id="@+id/historySections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="2dp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
