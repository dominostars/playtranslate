<?xml version="1.0" encoding="utf-8"?>
<!-- The voice service's settings page (OnlineTtsServiceActivity): the form,
     and over it the list of the service's models when the Model row is
     tapped. Laid out after activity_llm_backend_settings: one card of
     fields, a Save bar under the scrolling content. Every EditText has an id
     of its own, so each saves and restores its own text. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/ptSurface"
        app:navigationIcon="@drawable/ic_close"
        app:navigationIconTint="?attr/ptText"
        app:titleTextColor="?attr/ptText" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/ptDivider" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- The form. -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/formScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/pt_section_h_padding"
                android:paddingTop="12dp"
                android:paddingBottom="20dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="?attr/ptCard"
                    app:cardCornerRadius="@dimen/pt_radius"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/ptDivider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <include layout="@layout/settings_row_value"
                            android:id="@+id/rowService" />

                        <include layout="@layout/settings_row_divider" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingHorizontal="@dimen/pt_row_h_padding"
                            android:paddingVertical="@dimen/pt_row_v_padding">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:labelFor="@+id/etVoiceServiceUrl"
                                android:text="@string/voice_service_url_label"
                                style="@style/Text.PT.FieldLabel" />

                            <EditText
                                android:id="@+id/etVoiceServiceUrl"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:textSize="13sp"
                                android:fontFamily="monospace"
                                android:inputType="textUri|textMultiLine"
                                android:imeOptions="flagNoFullscreen|flagNoExtractUi"
                                android:importantForAutofill="no"
                                style="@style/Widget.PlayTranslate.TextField" />
                        </LinearLayout>

                        <!-- Shown only while the request holds {key}. -->
                        <LinearLayout
                            android:id="@+id/sectionVoiceServiceKey"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <include layout="@layout/settings_row_divider" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:paddingHorizontal="@dimen/pt_row_h_padding"
                                android:paddingVertical="@dimen/pt_row_v_padding">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:labelFor="@+id/etVoiceServiceKey"
                                    android:text="@string/voice_service_api_key_label"
                                    style="@style/Text.PT.FieldLabel" />

                                <EditText
                                    android:id="@+id/etVoiceServiceKey"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:textSize="13sp"
                                    android:fontFamily="monospace"
                                    android:singleLine="true"
                                    android:inputType="textVisiblePassword"
                                    android:importantForAutofill="no"
                                    style="@style/Widget.PlayTranslate.TextField" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Shown only while the request holds {model}. -->
                        <LinearLayout
                            android:id="@+id/sectionVoiceServiceModel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <include layout="@layout/settings_row_divider" />

                            <include layout="@layout/settings_row_value"
                                android:id="@+id/rowModel" />
                        </LinearLayout>

                        <!-- Shown only while the request holds {instructions}. -->
                        <LinearLayout
                            android:id="@+id/sectionVoiceServiceInstructions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <include layout="@layout/settings_row_divider" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:paddingHorizontal="@dimen/pt_row_h_padding"
                                android:paddingVertical="@dimen/pt_row_v_padding">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:labelFor="@+id/etVoiceServiceInstructions"
                                    android:text="@string/voice_service_instructions_label"
                                    style="@style/Text.PT.FieldLabel" />

                                <EditText
                                    android:id="@+id/etVoiceServiceInstructions"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:textSize="14sp"
                                    android:gravity="top|start"
                                    android:minLines="2"
                                    android:inputType="textMultiLine|textCapSentences"
                                    android:imeOptions="flagNoFullscreen|flagNoExtractUi"
                                    android:importantForAutofill="no"
                                    style="@style/Widget.PlayTranslate.TextField" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <include layout="@layout/settings_group_header"
                    android:id="@+id/headerVoiceServiceAdvanced" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="?attr/ptCard"
                    app:cardCornerRadius="@dimen/pt_radius"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/ptDivider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingHorizontal="@dimen/pt_row_h_padding"
                            android:paddingVertical="@dimen/pt_row_v_padding">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:labelFor="@+id/etVoiceServiceRequest"
                                android:text="@string/voice_service_request_label"
                                style="@style/Text.PT.FieldLabel" />

                            <EditText
                                android:id="@+id/etVoiceServiceRequest"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:textSize="12sp"
                                android:fontFamily="monospace"
                                android:gravity="top|start"
                                android:minLines="5"
                                android:inputType="textMultiLine|textNoSuggestions"
                                android:imeOptions="flagNoFullscreen|flagNoExtractUi"
                                android:importantForAutofill="no"
                                style="@style/Widget.PlayTranslate.TextField" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/voice_service_request_legend"
                                style="@style/Text.PT.RowSubtitle" />
                        </LinearLayout>

                        <include layout="@layout/settings_row_divider" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingHorizontal="@dimen/pt_row_h_padding"
                            android:paddingVertical="@dimen/pt_row_v_padding">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:labelFor="@+id/etVoiceServiceManualVoices"
                                android:text="@string/voice_service_manual_voices_label"
                                style="@style/Text.PT.FieldLabel" />

                            <EditText
                                android:id="@+id/etVoiceServiceManualVoices"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:textSize="13sp"
                                android:fontFamily="monospace"
                                android:gravity="top|start"
                                android:minLines="2"
                                android:inputType="textMultiLine|textNoSuggestions"
                                android:imeOptions="flagNoFullscreen|flagNoExtractUi"
                                android:importantForAutofill="no"
                                style="@style/Widget.PlayTranslate.TextField" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/voice_service_manual_voices_hint"
                                style="@style/Text.PT.RowSubtitle" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Shown only while a service is connected. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVoiceServiceRemove"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pt_group_gap"
                    app:cardBackgroundColor="?attr/ptCard"
                    app:cardCornerRadius="@dimen/pt_radius"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/ptDivider"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/rowVoiceServiceRemove"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/pt_row_min_height"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="@dimen/pt_row_h_padding"
                        android:paddingVertical="@dimen/pt_row_v_padding"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="@string/voice_service_remove"
                        android:textColor="?attr/ptDanger"
                        style="@style/Text.PT.RowTitle" />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- The service's models, over the form while the Model row's list
             is open. -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/modelPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/ptSurface"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/pt_section_h_padding"
                android:paddingTop="12dp"
                android:paddingBottom="20dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="?attr/ptCard"
                    app:cardCornerRadius="@dimen/pt_radius"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/ptDivider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:id="@+id/modelRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pt_group_gap"
                    app:cardBackgroundColor="?attr/ptCard"
                    app:cardCornerRadius="@dimen/pt_radius"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/ptDivider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/pt_row_h_padding"
                        android:paddingVertical="@dimen/pt_row_v_padding">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:labelFor="@+id/etVoiceServiceOtherModel"
                            android:text="@string/voice_service_model_other_label"
                            style="@style/Text.PT.FieldLabel" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <EditText
                                android:id="@+id/etVoiceServiceOtherModel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="13sp"
                                android:fontFamily="monospace"
                                android:singleLine="true"
                                android:inputType="textVisiblePassword"
                                android:importantForAutofill="no"
                                style="@style/Widget.PlayTranslate.TextField" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnVoiceServiceUseModel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="@string/voice_service_model_use"
                                android:textAllCaps="false" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <View
        android:id="@+id/voiceServiceSaveDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/ptDivider" />

    <FrameLayout
        android:id="@+id/voiceServiceSaveBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVoiceServiceSave"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/btn_save"
            android:textAllCaps="false"
            android:textSize="15sp"
            app:cornerRadius="12dp" />

        <!-- Over the button while Save asks the service for its models. -->
        <ProgressBar
            android:id="@+id/progressVoiceServiceSave"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone"
            android:indeterminateTint="?attr/colorOnPrimary" />
    </FrameLayout>

</LinearLayout>
