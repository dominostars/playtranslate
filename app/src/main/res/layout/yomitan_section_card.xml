<?xml version="1.0" encoding="utf-8"?>
<!-- One Yomitan category section: group header + card-wrapped list. Inflated
     per non-empty category by YomitanSettingsActivity.renderSections. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include layout="@layout/settings_group_header"
        android:id="@+id/yomitanSectionHeader" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/ptCard"
        app:cardCornerRadius="@dimen/pt_radius"
        app:cardElevation="0dp"
        app:strokeColor="?attr/ptDivider"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvYomitanSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- Fixed footer (TERMS only): sits below the reorderable list,
                 outside the adapter, so it can't be dragged. The divider
                 mirrors the in-card row dividers above it. -->
            <View
                android:id="@+id/yomitanSectionFooterDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/pt_row_h_padding"
                android:background="?attr/ptDivider"
                android:visibility="gone" />

            <include
                android:id="@+id/yomitanSectionFooterToggle"
                layout="@layout/settings_row_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- Second fixed footer slot (TERMS only): dictionary styling. -->
            <View
                android:id="@+id/yomitanSectionFooterDivider2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/pt_row_h_padding"
                android:background="?attr/ptDivider"
                android:visibility="gone" />

            <include
                android:id="@+id/yomitanSectionFooterToggle2"
                layout="@layout/settings_row_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
