<?xml version="1.0" encoding="utf-8"?>
<!-- PlayTranslate Cloud page (Settings → Configure, debug builds only), top to
     bottom: the intro paragraph, what the service is; the closed card while
     the service has closed; the ACCOUNT group, whose card is where sign-in
     happens (signed out, code sent, signed in: one group at a time; signed
     in, it holds Join while Join is due, and the terms row while the
     current terms are not accepted); the CONFIGURATION group, the two
     "use for" switches, while a key is stored; and the service status.
     PtCloudSettingsActivity.render sets every visibility, every dynamic text
     and the account line's colour. The service's address is fixed in the
     client, with no field here.
     On the activity_translation_history.xml template. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/ptSurface"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="?attr/ptText"
        app:title="@string/pt_cloud_display_name_alpha"
        app:titleTextColor="?attr/ptText" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/ptDivider" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingHorizontal="14dp"
        android:paddingBottom="20dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- What the service is, in every state, outside the cards and
                 inset as the group headers are. Its text names the service,
                 so the page sets it. -->
            <TextView
                android:id="@+id/tvCloudIntro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:paddingHorizontal="4dp"
                android:textSize="13sp"
                style="@style/Text.PT.RowSubtitle" />

            <!-- The service has closed: its title and the server's message
                 verbatim, in place of the ACCOUNT group. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCloudClosed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/ptCard"
                app:cardCornerRadius="@dimen/pt_radius"
                app:cardElevation="0dp"
                app:strokeColor="?attr/ptDivider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/pt_row_h_padding"
                    android:paddingVertical="@dimen/pt_row_v_padding">

                    <TextView
                        android:id="@+id/tvCloudClosedTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Text.PT.RowTitle" />

                    <TextView
                        android:id="@+id/tvCloudClosedMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        style="@style/Text.PT.RowSubtitle" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- The account card's header, which titles it (the card has no
                 title of its own); hidden with the card while closed. -->
            <include layout="@layout/settings_group_header"
                android:id="@+id/headerCloudAccount" />

            <!-- The account: sign-in while signed out, the code while one is
                 on its way, the account's state once signed in. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCloudAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/ptCard"
                app:cardCornerRadius="@dimen/pt_radius"
                app:cardElevation="0dp"
                app:strokeColor="?attr/ptDivider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/pt_row_h_padding"
                    android:paddingVertical="@dimen/pt_row_v_padding">

                    <!-- Signed out: the email field, the agreement box and
                         Try for Free, which sends the code. -->
                    <LinearLayout
                        android:id="@+id/groupSignedOut"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <!-- Its margin below, so the card's top inset is the
                             same whether it shows or not. -->
                        <TextView
                            android:id="@+id/tvKeyRefused"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            android:text="@string/pt_cloud_key_no_longer_accepted"
                            android:textColor="?attr/ptWarning"
                            android:visibility="gone"
                            style="@style/Text.PT.RowSubtitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:labelFor="@+id/etCloudEmail"
                            android:text="@string/pt_cloud_email_label"
                            style="@style/Text.PT.RowTitle" />

                        <!-- Autofilled as an email address, unlike the page's
                             other field. -->
                        <EditText
                            android:id="@+id/etCloudEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:hint="@string/pt_cloud_email_hint"
                            android:textColorHint="?attr/ptTextHint"
                            android:textColor="?attr/ptText"
                            android:textSize="13sp"
                            android:singleLine="true"
                            android:inputType="textEmailAddress"
                            android:autofillHints="emailAddress"
                            android:importantForAutofill="yes"
                            android:background="?attr/ptSurface"
                            android:padding="10dp" />

                        <!-- The agreement: the box is the agreement itself, the
                             sentence's last words a link that opens the terms
                             page to read. The row toggles the box (a tap off
                             the link falls through to it); the box lights in
                             its error state when Try for Free is tapped with it
                             unticked. The sentence's text and its link are the
                             page's; the sentence labels the box and shows a
                             controller's focus by its background. -->
                        <LinearLayout
                            android:id="@+id/rowCloudAgree"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:minHeight="48dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="false">

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cbCloudAgree"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:buttonTint="@color/checkbox_button"
                                app:errorAccessibilityLabel="@string/pt_cloud_agree_required" />

                            <TextView
                                android:id="@+id/tvCloudAgree"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:labelFor="@id/cbCloudAgree"
                                android:background="?attr/selectableItemBackground"
                                android:paddingVertical="12dp"
                                android:textColor="?attr/ptText"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- The LLM page's Save pattern: the spinner overlays
                             the blanked, disabled button while the request
                             is in flight. 56dp tall and bold, as Start Free
                             Trial and Join are. The button's label names the
                             service, so the page sets it. -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="16dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCloudSendCode"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:textAllCaps="false"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                app:cornerRadius="12dp" />

                            <ProgressBar
                                android:id="@+id/progressCloudSendCode"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:indeterminate="true"
                                android:visibility="gone"
                                android:indeterminateTint="?attr/colorOnPrimary" />
                        </FrameLayout>

                        <!-- The lines under the button are centred, as
                             Join's subtitle is. -->
                        <TextView
                            android:id="@+id/tvSignInNotice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_horizontal"
                            android:textColor="?attr/ptWarning"
                            android:visibility="gone"
                            style="@style/Text.PT.RowSubtitle" />

                        <TextView
                            android:id="@+id/tvSignInPrivacy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center_horizontal"
                            android:text="@string/pt_cloud_privacy_signin"
                            style="@style/Text.PT.RowSubtitle" />
                    </LinearLayout>

                    <!-- Code sent: the code field and Start Free Trial, which
                         the keyboard's Done also presses. -->
                    <LinearLayout
                        android:id="@+id/groupCodeSent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvCodeSentTo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Text.PT.RowSubtitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:labelFor="@+id/etCloudCode"
                            android:text="@string/pt_cloud_code_label"
                            style="@style/Text.PT.RowTitle" />

                        <!-- Digits only, at most six: the page's filter keeps
                             the digits of a pasted "482 913". -->
                        <EditText
                            android:id="@+id/etCloudCode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:hint="@string/pt_cloud_code_hint"
                            android:textColorHint="?attr/ptTextHint"
                            android:textColor="?attr/ptText"
                            android:textSize="15sp"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.2"
                            android:singleLine="true"
                            android:inputType="number"
                            android:imeOptions="actionDone"
                            android:background="?attr/ptSurface"
                            android:padding="10dp"
                            android:importantForAutofill="no" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="16dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCloudSignIn"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:text="@string/pt_cloud_start_free_trial"
                                android:textAllCaps="false"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                app:cornerRadius="12dp" />

                            <ProgressBar
                                android:id="@+id/progressCloudSignIn"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:indeterminate="true"
                                android:visibility="gone"
                                android:indeterminateTint="?attr/colorOnPrimary" />
                        </FrameLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCloudSendNewCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/pt_cloud_send_new_code"
                            android:textAllCaps="false"
                            style="@style/Widget.Material3.Button.TextButton" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCloudChangeEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pt_cloud_change_email"
                            android:textAllCaps="false"
                            style="@style/Widget.Material3.Button.TextButton" />

                        <TextView
                            android:id="@+id/tvCodeNotice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="?attr/ptWarning"
                            android:visibility="gone"
                            style="@style/Text.PT.RowSubtitle" />
                    </LinearLayout>

                    <!-- Signed in: the account (its address as the title, the
                         account line under it) beside the sign-out chip; Join,
                         under a divider, while it is due; Check again once the
                         trial ended or no membership is active; Show terms
                         while the current terms are not accepted. -->
                    <LinearLayout
                        android:id="@+id/groupSignedIn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvSignedInAs"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    style="@style/Text.PT.RowTitle" />

                                <TextView
                                    android:id="@+id/tvAccountLine"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:visibility="gone"
                                    style="@style/Text.PT.RowSubtitle" />

                                <TextView
                                    android:id="@+id/tvAccountUnchecked"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/pt_cloud_account_unchecked"
                                    android:textColor="?attr/ptWarning"
                                    android:visibility="gone"
                                    style="@style/Text.PT.RowSubtitle" />
                            </LinearLayout>

                            <!-- Sign out, confirmed in an OverlayAlert: the hub
                                 cell's icon chip with no text, its glyph in the
                                 least prominent text colour, so a rare action
                                 does not stand out, its description read as
                                 Sign out. -->
                            <FrameLayout
                                android:id="@+id/btnCloudSignOut"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginStart="12dp"
                                android:background="@drawable/bg_hub_chip"
                                android:foreground="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:contentDescription="@string/pt_cloud_sign_out">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_logout"
                                    android:importantForAccessibility="no"
                                    app:tint="?attr/ptTextHint" />
                            </FrameLayout>
                        </LinearLayout>

                        <!-- Sets Join off from the account above it; shown
                             with Join. -->
                        <View
                            android:id="@+id/dividerCloudJoin"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="14dp"
                            android:background="?attr/ptDivider"
                            android:visibility="gone" />

                        <!-- Join, the Ko-fi tiers page, under the account line
                             that says why (the trial, its end, no active
                             membership), in Try for Free's shape; the line
                             under it, centred, names the address to pay
                             with. -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCloudJoin"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="12dp"
                            android:textAllCaps="false"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            app:cornerRadius="12dp" />

                        <TextView
                            android:id="@+id/tvJoinSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_horizontal"
                            android:visibility="gone"
                            style="@style/Text.PT.RowSubtitle" />

                        <!-- Already joined?, a section of its own under a
                             divider once the trial ended or no membership
                             is active: the line and, at the row's right end,
                             Check again as the sign-out chip's twin (the
                             sync glyph, no text, described as Check again),
                             whose spinner takes the glyph's place while the
                             check runs. -->
                        <View
                            android:id="@+id/dividerCloudCheckAgain"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="14dp"
                            android:background="?attr/ptDivider"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/rowCloudCheckAgain"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tvJoinPending"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/pt_cloud_join_pending"
                                style="@style/Text.PT.RowSubtitle" />

                            <FrameLayout
                                android:id="@+id/btnCloudCheckAgain"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginStart="12dp"
                                android:background="@drawable/bg_hub_chip"
                                android:foreground="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:contentDescription="@string/pt_cloud_check_again">

                                <ImageView
                                    android:id="@+id/ivCloudCheckAgain"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_sync"
                                    android:importantForAccessibility="no"
                                    app:tint="?attr/ptTextHint" />

                                <ProgressBar
                                    android:id="@+id/progressCloudCheckAgain"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:indeterminate="true"
                                    android:visibility="gone"
                                    android:indeterminateTint="?attr/ptTextHint" />
                            </FrameLayout>
                        </LinearLayout>

                        <!-- The terms, a section of its own under a divider
                             while the server says the current terms are not
                             accepted, in Already joined?'s place: the line
                             (it names the service, so the page sets it) and,
                             at the row's right end, Show terms as the Check
                             again chip's twin (the description glyph, no
                             text, described as Show terms), whose spinner
                             takes the glyph's place while a terms call runs;
                             under the row, a failed terms call's notice. -->
                        <View
                            android:id="@+id/dividerCloudTerms"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="14dp"
                            android:background="?attr/ptDivider"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/rowCloudTerms"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tvTermsPending"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                style="@style/Text.PT.RowSubtitle" />

                            <FrameLayout
                                android:id="@+id/btnCloudShowTerms"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginStart="12dp"
                                android:background="@drawable/bg_hub_chip"
                                android:foreground="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:contentDescription="@string/pt_cloud_show_terms">

                                <ImageView
                                    android:id="@+id/ivCloudShowTerms"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_description"
                                    android:importantForAccessibility="no"
                                    app:tint="?attr/ptTextHint" />

                                <ProgressBar
                                    android:id="@+id/progressCloudShowTerms"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:indeterminate="true"
                                    android:visibility="gone"
                                    android:indeterminateTint="?attr/ptTextHint" />
                            </FrameLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvTermsNotice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="?attr/ptWarning"
                            android:visibility="gone"
                            style="@style/Text.PT.RowSubtitle" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- The switches' header, shown with their card. -->
            <include layout="@layout/settings_group_header"
                android:id="@+id/headerCloudConfiguration"
                android:visibility="gone" />

            <!-- The two "use for" switches, one per route: Read captures (OCR)
                 and Translate. Independent; no master switch. Shown while a key
                 is stored, disabled and off while the service is closed. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCloudUseFor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/ptCard"
                app:cardCornerRadius="@dimen/pt_radius"
                app:cardElevation="0dp"
                app:strokeColor="?attr/ptDivider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include layout="@layout/settings_row_switch"
                        android:id="@+id/rowCloudOcr" />

                    <include layout="@layout/settings_row_divider" />

                    <include layout="@layout/settings_row_switch"
                        android:id="@+id/rowCloudTranslate" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Service status (GET /health), refreshed on resume and when a
                 key is stored, with the cooldown line below it while one runs
                 (hidden while closed, and while the account line says the
                 trial ended, no membership is active or the terms are not
                 accepted). Not tappable; no header, it reads under whichever
                 group precedes it. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="?attr/ptCard"
                app:cardCornerRadius="@dimen/pt_radius"
                app:cardElevation="0dp"
                app:strokeColor="?attr/ptDivider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/pt_row_min_height"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/pt_row_h_padding"
                    android:paddingVertical="@dimen/pt_row_v_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/pt_cloud_status_title"
                            style="@style/Text.PT.RowTitle" />

                        <TextView
                            android:id="@+id/tvCloudStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pt_cloud_status_unchecked"
                            style="@style/Text.PT.RowValue" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCloudCooldown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="?attr/ptWarning"
                        android:visibility="gone"
                        style="@style/Text.PT.RowSubtitle" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

