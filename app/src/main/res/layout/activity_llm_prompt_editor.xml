<?xml version="1.0" encoding="utf-8"?>
<!-- LLM prompt editor sub-screen (Advanced LLM Configuration). One layout
     serves all three prompt kinds — the toolbar title, prefilled template,
     and keyword legend are set programmatically per PromptKind, so
     app:title is intentionally omitted on the toolbar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/ptSurface"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="?attr/ptText"
        app:titleTextColor="?attr/ptText" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/ptDivider" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/pt_section_h_padding"
            android:paddingTop="4dp"
            android:paddingBottom="20dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="?attr/ptCard"
                app:cardCornerRadius="@dimen/pt_radius"
                app:cardElevation="0dp"
                app:strokeColor="?attr/ptDivider"
                app:strokeWidth="1dp">

                <!-- The raw template with {token} keywords, monospace like
                     the base-URL/API-key fields. flagNoFullscreen +
                     flagNoExtractUi keep the landscape IME from swallowing
                     the page into the fullscreen extract editor. -->
                <EditText
                    android:id="@+id/etPrompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="180dp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:imeOptions="flagNoFullscreen|flagNoExtractUi"
                    android:textColor="?attr/ptText"
                    android:textColorHint="?attr/ptTextHint"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:background="@null"
                    android:padding="12dp"
                    android:importantForAutofill="no" />

            </com.google.android.material.card.MaterialCardView>

            <include layout="@layout/settings_group_header"
                android:id="@+id/headerKeywords" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/ptCard"
                app:cardCornerRadius="@dimen/pt_radius"
                app:cardElevation="0dp"
                app:strokeColor="?attr/ptDivider"
                app:strokeWidth="1dp">

                <!-- One keyword-legend row per PromptKind keyword,
                     populated in code. -->
                <LinearLayout
                    android:id="@+id/legendContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="6dp" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/ptDivider" />

    <!-- Save bar: same shape as activity_llm_backend_settings, minus the
         progress overlay — validation here is local and synchronous. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/deepl_settings_save"
            android:textAllCaps="false"
            android:textSize="15sp"
            app:cornerRadius="12dp" />

    </FrameLayout>

</LinearLayout>
