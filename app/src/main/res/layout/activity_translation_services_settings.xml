<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/ptSurface"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="?attr/ptText"
        app:title="@string/settings_cell_translation_services"
        app:titleTextColor="?attr/ptText" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/ptDivider" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/pt_section_h_padding"
            android:paddingTop="4dp"
            android:paddingBottom="20dp">

            <!-- ══════════════════════════════════════════════════════ -->
            <!-- ONLINE TRANSLATIONS                                   -->
            <!-- ══════════════════════════════════════════════════════ -->

            <include layout="@layout/settings_group_header"
                android:id="@+id/headerOnlineTranslations" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/ptCard"
                app:cardCornerRadius="@dimen/pt_radius"
                app:cardElevation="0dp"
                app:strokeColor="?attr/ptDivider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Fixed action row above the reorderable instance
                         list (outside the RecyclerView so it can't be
                         dragged); hidden in edit mode. -->
                    <include layout="@layout/settings_row_add"
                        android:id="@+id/rowAddOnlineService" />

                    <View
                        android:id="@+id/dividerAddOnlineService"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="@dimen/pt_row_h_padding"
                        android:background="?attr/ptDivider" />

                    <!-- The user's online service instances, in waterfall
                         priority order. Recycler-in-card recipe from
                         yomitan_section_card.xml — measures full height
                         inside the page's NestedScrollView. -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvOnlineServices"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_word_tatoeba_attribution"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="10dp"
                        android:text="@string/tr_service_order_footer"
                        android:textColor="?attr/ptTextHint"
                        android:textSize="11sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════════════════════ -->
            <!-- OFFLINE TRANSLATIONS                                  -->
            <!-- ══════════════════════════════════════════════════════ -->

            <include layout="@layout/settings_group_header"
                android:id="@+id/headerOfflineTranslations" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/ptCard"
                app:cardCornerRadius="@dimen/pt_radius"
                app:cardElevation="0dp"
                app:strokeColor="?attr/ptDivider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Premium-quality manual-lookup tier (replaces the
                         legacy TranslateGemma). -->
                    <include layout="@layout/settings_row_backend_offline"
                        android:id="@+id/rowBackendGemmaE2bMnn" />

                    <!-- Hy-MT2 (translation-specialist tier). Apache-2.0:
                         no region gate, no legal attestation. -->
                    <include layout="@layout/settings_row_divider"
                        android:id="@+id/dividerBackendHyMt2" />

                    <include layout="@layout/settings_row_backend_offline"
                        android:id="@+id/rowBackendHyMt2" />

                    <!-- Divider above the retired Hunyuan-MT 1.5 row. That row
                         and this divider hide when
                         RegionPolicy.isHunyuanRestricted returns true (EU/UK/SK)
                         — see TranslationServicesBinder.wireHyMtBackendRow — and,
                         since the catalog entry is deprecated, also whenever the
                         model is not fully installed (renderOfflineBackendRow's
                         deprecation gate). -->
                    <include layout="@layout/settings_row_divider"
                        android:id="@+id/dividerBackendHyMt" />

                    <include layout="@layout/settings_row_backend_offline"
                        android:id="@+id/rowBackendHyMt" />

                    <!-- Qwen 3.5 2B (fast tier; replaces the deprecated Qwen 2.5). -->
                    <include layout="@layout/settings_row_divider"
                        android:id="@+id/dividerBackendQwen35Mnn2b" />

                    <include layout="@layout/settings_row_backend_offline"
                        android:id="@+id/rowBackendQwen35Mnn2b" />

                    <!-- Divider above the deprecated Qwen 2.5 MNN tier (the row
                         and this divider hide unless the model is installed —
                         see SettingsRenderer deprecation gating). -->
                    <include layout="@layout/settings_row_divider"
                        android:id="@+id/dividerBackendQwenMnn" />

                    <include layout="@layout/settings_row_backend_offline"
                        android:id="@+id/rowBackendQwenMnn" />

                    <include layout="@layout/settings_row_divider"
                        android:id="@+id/dividerBackendBergamot" />

                    <include layout="@layout/settings_row_backend_offline"
                        android:id="@+id/rowBackendBergamot" />

                    <include layout="@layout/settings_row_divider" />

                    <include layout="@layout/settings_row_backend_offline"
                        android:id="@+id/rowBackendMlkit" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_word_tatoeba_attribution"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="10dp"
                        android:text="@string/tr_service_offline_footer"
                        android:textColor="?attr/ptTextHint"
                        android:textSize="11sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════════════════════ -->
            <!-- ADVANCED LLM CONFIGURATION                            -->
            <!-- ══════════════════════════════════════════════════════ -->

            <include layout="@layout/settings_group_header"
                android:id="@+id/headerAdvancedLlm" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/ptCard"
                app:cardCornerRadius="@dimen/pt_radius"
                app:cardElevation="0dp"
                app:strokeColor="?attr/ptDivider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Feed recent translated lines to LLM backends as
                         {context} in the Translation prompt. -->
                    <include layout="@layout/settings_row_switch"
                        android:id="@+id/rowLlmContext" />

                    <include layout="@layout/settings_row_divider" />

                    <!-- User-editable prompt templates, global across all
                         eligible LLM backends (HyMt excluded — its
                         model-card format is fixed). Each row opens
                         LlmPromptEditorActivity for one PromptKind. -->
                    <include layout="@layout/settings_row_nav"
                        android:id="@+id/rowPromptSystem" />

                    <include layout="@layout/settings_row_divider" />

                    <include layout="@layout/settings_row_nav"
                        android:id="@+id/rowPromptTranslation" />

                    <include layout="@layout/settings_row_divider" />

                    <include layout="@layout/settings_row_nav"
                        android:id="@+id/rowPromptBatch" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
