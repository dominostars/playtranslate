<?xml version="1.0" encoding="utf-8"?>
<!-- One setting on the Keep-running page: a card around a link row (title,
     the one-line reason, and the open-in-new icon for rows with a screen to
     open; instruction-only rows hide the icon). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="?attr/ptCard"
    app:cardCornerRadius="@dimen/pt_radius"
    app:cardElevation="0dp"
    app:strokeColor="?attr/ptDivider"
    app:strokeWidth="1dp">

    <include
        android:id="@+id/rowKeepRunningItem"
        layout="@layout/settings_row_link" />

</com.google.android.material.card.MaterialCardView>
