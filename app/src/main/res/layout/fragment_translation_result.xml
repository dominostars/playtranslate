<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Status / hint text (shown when idle or processing) -->
    <LinearLayout
        android:id="@+id/statusContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:visibility="visible">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/status_idle"
            android:textColor="?attr/ptTextHint"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tvStatusHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/status_hold_hint"
            android:textColor="?attr/ptTextHint"
            android:textSize="24sp"
            android:layout_marginTop="28dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvLiveHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="?attr/ptTextHint"
            android:textSize="24sp"
            android:layout_marginTop="28dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Results scroll view (hidden until first translation) -->
    <ScrollView
        android:id="@+id/resultsContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <!-- The sections (results_sections.xml: each one a header + card
             pair) are direct children of this layout, which arranges them:
             stacked, or Original and Translation paired on top when the page
             is wide enough. The Clear row is its one other child and stacks
             beneath them. The bottom padding is the floating Anki pill's
             clearance, so content scrolled to the end clears the pill. -->
        <com.playtranslate.ui.ResultSectionsLayout
            android:id="@+id/resultsScrollContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/pt_section_h_padding"
            android:paddingTop="0dp"
            android:paddingBottom="@dimen/pt_anki_pill_clearance">

            <include layout="@layout/results_sections" />

            <!-- Action buttons row -->
            <LinearLayout
                android:id="@+id/resultActionButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResultClear"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/btn_clear"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:strokeColor="?attr/ptTextMuted"
                    app:cornerRadius="6dp" />

            </LinearLayout>

        </com.playtranslate.ui.ResultSectionsLayout>

    </ScrollView>

    <!-- The floating Anki pill (TranslationResultContent shows it with the
         results), in a layer of its own: full size, so the pill's shadow is
         not clipped, and with no elevation, so the page's popovers, which
         PopoverHost adds to this root after it, draw over the pill and take
         its taps while one is open. In the root directly, the pill's
         elevation would lift it above them. Not clickable, so touches
         anywhere else pass through to the results. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include layout="@layout/anki_pill" />

    </FrameLayout>

    <!-- The capture-mode row (two screens): what the next capture paints
         over the game display. It overlays the top of the root; the status
         and result areas take a matching top margin while it shows. -->
    <FrameLayout
        android:id="@+id/captureModeRow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/pt_row_min_height"
        android:layout_gravity="top"
        android:paddingStart="@dimen/pt_section_h_padding"
        android:paddingEnd="@dimen/pt_section_h_padding"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:visibility="gone" />

</FrameLayout>
